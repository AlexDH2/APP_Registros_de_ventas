{
  "expo": {
    "name": "Registro de Ventas",
    "slug": "Registro_Ventas",
    "scheme": "registro-ventas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.registroventas.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta aplicación requiere acceso a la cámara para tomar fotografías de comprobantes de pago y de entregas logísticas.",
        "NSPhotoLibraryUsageDescription": "Esta aplicación requiere acceso a tu galería para adjuntar comprobantes de pago."
      }
    },
    "android": {
      "package": "com.registroventas.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "La aplicación necesita acceso a tus fotos para adjuntar comprobantes.",
          "cameraPermission": "La aplicación necesita acceso a tu cámara para fotografiar comprobantes y entregas."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4d4682b-8c7b-4713-9695-16067defb308"
      }
    },
    "owner": "alexdh"
  }
}
